# BRIDGE_BASE_URL / BRIDGE_LOCAL_PORT 仅 iproxy 模式需要（本地 iproxy 转发端口）
# CoreDevice 隧道模式下 ensureBridgeReachable 会用 tunnelIP 覆盖 BRIDGE_BASE_URL，这两项不生效
BRIDGE_BASE_URL=http://127.0.0.1:42671
LOOKIN_CLI_PATH=lookin-cli
LOOKIN_MODE=auto
LOOKIN_HOST=127.0.0.1
LOOKDEBUG_DEVICE_UDID=<your-device-udid>
IPROXY_PATH=iproxy
LOOKIN_LOCAL_PORT=47175
LOOKIN_REMOTE_PORT=47175
# 同 BRIDGE_BASE_URL：仅 iproxy 模式生效，隧道模式忽略
BRIDGE_LOCAL_PORT=42671
# BRIDGE_REMOTE_PORT 必须在 42671-42770 范围内，否则回退到默认 42671
BRIDGE_REMOTE_PORT=42671
LOOKIN_SCREENSHOT_COMMAND=
# 危险开关（默认关闭）：开启后允许 BRIDGE_LOCAL_PORT/BRIDGE_REMOTE_PORT 超出常规范围
# LOOKDEBUG_ALLOW_ANY_PORT=false
# 危险开关（默认关闭）：开启后允许 BRIDGE_BASE_URL 指向非回环主机
# LOOKDEBUG_ALLOW_ANY_URL=false
# 可选：artifact 根目录，设置后 audit_runtime 的输入/输出路径必须位于其内
# LOOKDEBUG_ARTIFACT_ROOT=/path/to/artifacts
